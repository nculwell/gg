#!/usr/bin/env python3
# vim: et ts=8 sts=4 sw=4

import argparse
import os
import sqlite3
import subprocess
import sys

# GREATER GIT
#
# This is a tool for automating various tasks with Git. The most important
# feature is that it assigns each branch a "base" that is not its upstream.
# This allows us to set its upstream to a corresponding remote branch
# (typically origin/my-branch-name) while saving which branch it should rebase
# against.
#
# Extra branch info is stored in a sqlite3 database. The user has one central
# DB that tracks branches for all repos.

# = USAGE EXAMPLES =
#
# == UNIVERSAL OPTIONS ==
#
# Override the default gg DB path:
# -d <db-path> | --db <db-path>
# (The default path is: $HOME/.local/state/gg/repos.sqlite)
#
# == COMMANDS ==
#
# Show info about the current branch in the given repo (default = current
# repo).
# $ gg [<repo-root-path>]
#
# Create a new branch from the specified base, and push it to origin. If the
# base is a MAIN or PROJECT branch, the new branch gets that branch as its
# base. If the base is a STORY branch, the new branch copies the base's base.
# $ gg branch <base-branch-name> <new-branch-name>
#
# Rebase the current branch against its base.
# $ gg rebase [-i]
#
# Merge the current branch's base onto it.
# $ gg merge
#
# Push the current branch to the given remote, or by default to all collab and
# mirror remotes.
# $ gg push [-f] [<remote>]
#
# Pull the current branch from the given remote, or by default from all collab
# remotes.
# $ gg pull [<remote>]
#
# Fetch all remotes.
# $ gg fetch
#
# Scan the given path and subdirs for any git repos to add to the database.
# $ gg repo scan [--max-depth n] <scan-path>
#
# Add the specified repo (default: the one containing the cwd) to the database,
# recording its main branch (from <first-remote>/HEAD) as a MAIN branch.
# $ gg repo init [<repo-path>]
#
# Add/remove type(s) and/or attribute(s) for the specified remote.
# Types are: MAIN, PROJECT, STORY. Attributes are MIRROR, COLLAB.
# $ gg repo remote <remote-name> [+<type>] [...] [-<type>] [...]
#
# List all repos in the DB.
# $ gg repo list
#
# Show info about branches in the given repo (
# $ gg repo branches [<repo-root-path>]
#
# Print a bash completion script. Load it from ~/.bashrc with:
#   eval "$(gg completion)"
# or install it to ~/.local/share/bash-completion/completions/gg with
# --install.
# $ gg completion [--install]

# Database setup
DB_SCHEMA = """

create table if not exists branch (
    repo_id integer,
    branch_name text,
    branch_base text,
    branch_type text, -- MAIN, PROJECT, STORY
    branch_is_mirror integer, -- bool
    branch_is_collab integer, -- bool
    primary key (repo_id, branch_name)
);

create table if not exists repo (
    repo_id integer,
    repo_root_path text,
    primary key (repo_id)
);
create unique index if not exists ix_repo_root on repo (repo_root_path);

"""

DEFAULT_DB_PATH = os.path.join(
    os.path.expanduser("~"), ".local", "state", "gg", "repos.sqlite"
)

COMPLETION_INSTALL_PATH = os.path.join(
    os.path.expanduser("~"),
    ".local",
    "share",
    "bash-completion",
    "completions",
    "gg",
)

# Directories that `repo scan` never descends into.
SCAN_SKIP_DIRS = {"node_modules"}

BASH_COMPLETION = r"""
_gg() {
    local cur prev cmd sub i refs
    cur=${COMP_WORDS[COMP_CWORD]}
    prev=${COMP_WORDS[COMP_CWORD-1]}

    if [[ $prev == -d || $prev == --db ]]; then
        COMPREPLY=($(compgen -f -- "$cur"))
        return
    fi

    # Find the command word, skipping global options.
    i=1
    while (( i < COMP_CWORD )); do
        case ${COMP_WORDS[i]} in
            -d|--db) (( i += 2 )) ;;
            -*) (( i++ )) ;;
            *) break ;;
        esac
    done
    if (( i >= COMP_CWORD )); then
        if [[ $cur == -* ]]; then
            COMPREPLY=($(compgen -W "-d --db -h --help" -- "$cur"))
        else
            COMPREPLY=($(compgen -W "info branch rebase merge push pull
                fetch repo completion" -- "$cur"))
            COMPREPLY+=($(compgen -d -- "$cur"))
        fi
        return
    fi
    cmd=${COMP_WORDS[i]}

    case $cmd in
        info)
            COMPREPLY=($(compgen -d -- "$cur")) ;;
        branch)
            # Only the base is completable; the new name is free-form.
            if (( COMP_CWORD == i + 1 )); then
                refs=$(git for-each-ref --format='%(refname:short)' \
                    refs/heads refs/remotes 2>/dev/null)
                COMPREPLY=($(compgen -W "$refs" -- "$cur"))
            fi ;;
        rebase)
            COMPREPLY=($(compgen -W "-i --interactive" -- "$cur")) ;;
        push)
            if [[ $cur == -* ]]; then
                COMPREPLY=($(compgen -W "-f --force" -- "$cur"))
            else
                COMPREPLY=($(compgen -W "$(git remote 2>/dev/null)" -- "$cur"))
            fi ;;
        pull)
            COMPREPLY=($(compgen -W "$(git remote 2>/dev/null)" -- "$cur")) ;;
        completion)
            COMPREPLY=($(compgen -W "--install" -- "$cur")) ;;
        repo)
            if (( COMP_CWORD == i + 1 )); then
                COMPREPLY=($(compgen -W "scan init list branches" -- "$cur"))
                return
            fi
            sub=${COMP_WORDS[i+1]}
            case $sub in
                scan)
                    if [[ $prev == --max-depth ]]; then
                        return
                    elif [[ $cur == -* ]]; then
                        COMPREPLY=($(compgen -W "--max-depth" -- "$cur"))
                    else
                        COMPREPLY=($(compgen -d -- "$cur"))
                    fi ;;
                init|branches)
                    COMPREPLY=($(compgen -d -- "$cur")) ;;
            esac ;;
    esac
}
complete -o filenames -F _gg gg
"""


class GGError(Exception):
    pass


# Git helpers


def git(args, cwd=None):
    """Run git and return its stdout. Raises GGError on failure."""
    proc = subprocess.run(
        ["git", *args], cwd=cwd, capture_output=True, text=True, check=False
    )
    if proc.returncode != 0:
        raise GGError(
            "git %s failed:\n%s" % (" ".join(args), proc.stderr.strip())
        )
    return proc.stdout


def git_try(args, cwd=None):
    """Run git and return its stripped stdout, or None on failure."""
    proc = subprocess.run(
        ["git", *args], cwd=cwd, capture_output=True, text=True, check=False
    )
    if proc.returncode != 0:
        return None
    return proc.stdout.strip()


def git_run(args, cwd=None):
    """Run git attached to the terminal (interactive/long-running use)."""
    print("+ git " + " ".join(args), file=sys.stderr)
    proc = subprocess.run(["git", *args], cwd=cwd, check=False)
    if proc.returncode != 0:
        raise GGError("git %s failed." % " ".join(args))


def repo_root(path):
    if not os.path.isdir(path):
        raise GGError("Not a directory: %s" % path)
    root = git_try(["rev-parse", "--show-toplevel"], cwd=path)
    if not root:
        raise GGError("Not a git repo: %s" % path)
    return os.path.realpath(root)


def current_branch(root):
    name = git_try(["symbolic-ref", "--short", "-q", "HEAD"], cwd=root)
    if not name:
        raise GGError("HEAD is detached; not on a branch.")
    return name


def upstream_remote(root, branch):
    """The remote the branch tracks, defaulting to origin."""
    remote = git_try(
        ["config", "--get", "branch.%s.remote" % branch], cwd=root
    )
    if not remote or remote == ".":
        return "origin"
    return remote


def detect_main_branch(root):
    """The main branch per the first remote's HEAD, or None if unknown."""
    remotes = (git_try(["remote"], cwd=root) or "").split()
    if not remotes:
        return None
    remote = remotes[0]
    ref = git_try(
        ["rev-parse", "--abbrev-ref", "%s/HEAD" % remote], cwd=root
    )
    prefix = remote + "/"
    if not ref or not ref.startswith(prefix) or ref == prefix + "HEAD":
        return None
    return ref[len(prefix) :]


def collab_remotes(root, branch):
    # TODO: Use remote attributes once `gg repo remote` is implemented.
    return [upstream_remote(root, branch)]


def mirror_remotes(root, branch):
    # TODO: Use remote attributes once `gg repo remote` is implemented.
    return []


# DB helpers


def open_db(path):
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    db = sqlite3.connect(path)
    db.row_factory = sqlite3.Row
    db.executescript(DB_SCHEMA)
    return db


def add_repo(db, root):
    """Register a repo root. Returns (repo_id, was_added)."""
    row = db.execute(
        "select repo_id from repo where repo_root_path = ?", (root,)
    ).fetchone()
    if row is not None:
        return row["repo_id"], False
    cur = db.execute("insert into repo (repo_root_path) values (?)", (root,))
    db.commit()
    return cur.lastrowid, True


def open_repo(db, path="."):
    """Resolve the repo containing path, registering it if needed."""
    root = repo_root(path)
    repo_id, _ = add_repo(db, root)
    return root, repo_id


def get_branch(db, repo_id, name):
    return db.execute(
        "select * from branch where repo_id = ? and branch_name = ?",
        (repo_id, name),
    ).fetchone()


def require_base(db, root, repo_id):
    """Return (branch, base) for the current branch, which must have a base."""
    name = current_branch(root)
    row = get_branch(db, repo_id, name)
    if row is None or not row["branch_base"]:
        raise GGError("Branch %s has no base recorded in gg." % name)
    return name, row["branch_base"]


# Commands


def cmd_info(db, args):
    root, repo_id = open_repo(db, args.path or ".")
    print("Repo:     %s" % root)
    name = git_try(["symbolic-ref", "--short", "-q", "HEAD"], cwd=root)
    if not name:
        print("Branch:   (detached HEAD)")
        return
    print("Branch:   %s" % name)
    upstream = git_try(
        ["rev-parse", "--abbrev-ref", "%s@{upstream}" % name], cwd=root
    )
    print("Upstream: %s" % (upstream or "(none)"))
    row = get_branch(db, repo_id, name)
    if row is None:
        print("Type:     (not tracked by gg)")
        return
    print("Type:     %s" % (row["branch_type"] or "?"))
    base = row["branch_base"]
    print("Base:     %s" % (base or "(none)"))
    if base:
        counts = git_try(
            ["rev-list", "--left-right", "--count", "%s...%s" % (base, name)],
            cwd=root,
        )
        if counts:
            behind, ahead = counts.split()
            print("vs base:  %s ahead, %s behind" % (ahead, behind))


def cmd_branch(db, args):
    root, repo_id = open_repo(db)
    base_row = get_branch(db, repo_id, args.base)
    if base_row is not None and base_row["branch_type"] == "STORY":
        if not base_row["branch_base"]:
            raise GGError("Story branch %s has no base recorded." % args.base)
        new_base = base_row["branch_base"]
    else:
        new_base = args.base
    git_run(["switch", "-c", args.new, args.base], cwd=root)
    db.execute(
        "insert or replace into branch (repo_id, branch_name, branch_base,"
        " branch_type, branch_is_mirror, branch_is_collab)"
        " values (?, ?, ?, 'STORY', 0, 0)",
        (repo_id, args.new, new_base),
    )
    db.commit()
    git_run(["push", "-u", "origin", args.new], cwd=root)
    print("Created %s with base %s." % (args.new, new_base))


def cmd_rebase(db, args):
    root, repo_id = open_repo(db)
    _, base = require_base(db, root, repo_id)
    git_run(
        ["rebase"] + (["-i"] if args.interactive else []) + [base], cwd=root
    )


def cmd_merge(db, args):
    root, repo_id = open_repo(db)
    _, base = require_base(db, root, repo_id)
    git_run(["merge", base], cwd=root)


def cmd_push(db, args):
    root = repo_root(".")
    name = current_branch(root)
    if args.remote:
        remotes = [args.remote]
    else:
        remotes = collab_remotes(root, name)
        remotes += [r for r in mirror_remotes(root, name) if r not in remotes]
    force = ["--force-with-lease"] if args.force else []
    for remote in remotes:
        git_run(["push"] + force + [remote, name], cwd=root)


def cmd_pull(db, args):
    root = repo_root(".")
    name = current_branch(root)
    remotes = [args.remote] if args.remote else collab_remotes(root, name)
    for remote in remotes:
        git_run(["pull", remote, name], cwd=root)


def cmd_fetch(db, args):
    git_run(["fetch", "--all", "--prune"], cwd=repo_root("."))


def cmd_repo_init(db, args):
    root = repo_root(args.path or ".")
    repo_id, added = add_repo(db, root)
    print(
        "%s repo %d: %s"
        % ("Added" if added else "Already known:", repo_id, root)
    )
    main = detect_main_branch(root)
    if main is None:
        print(
            "Could not detect main branch (no remote, or its HEAD is unset).",
            file=sys.stderr,
        )
        return
    db.execute(
        "insert into branch (repo_id, branch_name, branch_type)"
        " values (?, ?, 'MAIN')"
        " on conflict (repo_id, branch_name)"
        " do update set branch_type = 'MAIN'",
        (repo_id, main),
    )
    db.commit()
    print("Main branch: %s" % main)


def cmd_repo_scan(db, args):
    top = os.path.realpath(args.path)
    if not os.path.isdir(top):
        raise GGError("Not a directory: %s" % args.path)
    top_depth = top.rstrip(os.sep).count(os.sep)
    added = known = 0
    for dirpath, dirnames, filenames in os.walk(top):
        if ".git" in dirnames or ".git" in filenames:
            dirnames[:] = []
            try:
                repo_id, was_added = add_repo(db, repo_root(dirpath))
            except GGError as e:
                print("Skipping %s: %s" % (dirpath, e), file=sys.stderr)
                continue
            if was_added:
                added += 1
                print("Added repo %d: %s" % (repo_id, dirpath))
            else:
                known += 1
            continue
        depth = dirpath.rstrip(os.sep).count(os.sep) - top_depth
        if args.max_depth is not None and depth >= args.max_depth:
            dirnames[:] = []
        else:
            dirnames[:] = [
                d
                for d in dirnames
                if not d.startswith(".") and d not in SCAN_SKIP_DIRS
            ]
    print("%d repo(s) added, %d already known." % (added, known))


def cmd_repo_list(db, args):
    for row in db.execute(
        "select repo_id, repo_root_path from repo order by repo_root_path"
    ):
        path = row["repo_root_path"]
        missing = "" if os.path.isdir(path) else "  (missing)"
        print("%4d  %s%s" % (row["repo_id"], path, missing))


def cmd_completion(db, args):
    if not args.install:
        sys.stdout.write(BASH_COMPLETION.lstrip())
        return
    os.makedirs(os.path.dirname(COMPLETION_INSTALL_PATH), exist_ok=True)
    with open(COMPLETION_INSTALL_PATH, "w") as f:
        f.write(BASH_COMPLETION.lstrip())
    print("Installed bash completion to %s" % COMPLETION_INSTALL_PATH)


def cmd_repo_branches(db, args):
    root, repo_id = open_repo(db, args.path or ".")
    current = git_try(["symbolic-ref", "--short", "-q", "HEAD"], cwd=root)
    local = git(
        ["for-each-ref", "--format=%(refname:short)", "refs/heads/"], cwd=root
    ).split()
    rows = {
        row["branch_name"]: row
        for row in db.execute(
            "select * from branch where repo_id = ?", (repo_id,)
        )
    }
    names = sorted(set(local) | set(rows))
    if not names:
        print("No branches.")
        return
    width = max(len(n) for n in names)
    for name in names:
        marker = "*" if name == current else " "
        row = rows.get(name)
        if row is None:
            info = "(untracked)"
        else:
            info = "%-7s  base: %s" % (
                row["branch_type"] or "?",
                row["branch_base"] or "(none)",
            )
            if name not in local:
                info += "  (gone)"
        print("%s %-*s  %s" % (marker, width, name, info))


# Argument parsing

COMMANDS = {
    "info",
    "branch",
    "rebase",
    "merge",
    "push",
    "pull",
    "fetch",
    "repo",
    "completion",
}


def normalize_argv(argv):
    """Allow `gg [<repo-root-path>]` by inserting the implicit `info`
    command.
    """
    i = 0
    while i < len(argv):
        if argv[i] in ("-d", "--db"):
            i += 2
        elif argv[i].startswith("-"):
            i += 1
        else:
            break
    if i >= len(argv) or argv[i] not in COMMANDS:
        argv = argv[:i] + ["info"] + argv[i:]
    return argv


def build_parser():
    parser = argparse.ArgumentParser(prog="gg", description="Greater Git")
    parser.add_argument(
        "-d",
        "--db",
        default=DEFAULT_DB_PATH,
        help="gg DB path (default: %(default)s)",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("info", help="show info about the current branch")
    p.add_argument("path", nargs="?")
    p.set_defaults(func=cmd_info)

    p = sub.add_parser(
        "branch", help="create a branch from a base and push it"
    )
    p.add_argument("base")
    p.add_argument("new")
    p.set_defaults(func=cmd_branch)

    p = sub.add_parser(
        "rebase", help="rebase the current branch against its base"
    )
    p.add_argument("-i", "--interactive", action="store_true")
    p.set_defaults(func=cmd_rebase)

    p = sub.add_parser("merge", help="merge the current branch's base onto it")
    p.set_defaults(func=cmd_merge)

    p = sub.add_parser(
        "push", help="push to a remote, or to collab and mirror remotes"
    )
    p.add_argument(
        "-f",
        "--force",
        action="store_true",
        help="push with --force-with-lease",
    )
    p.add_argument(
        "remote",
        nargs="?",
        help="remote to push to (default: collab and mirror remotes)",
    )
    p.set_defaults(func=cmd_push)

    p = sub.add_parser(
        "pull", help="pull from a remote, or from collab remotes"
    )
    p.add_argument(
        "remote",
        nargs="?",
        help="remote to pull from (default: collab remotes)",
    )
    p.set_defaults(func=cmd_pull)

    p = sub.add_parser("fetch", help="fetch all remotes")
    p.set_defaults(func=cmd_fetch)

    p = sub.add_parser("completion", help="print a bash completion script")
    p.add_argument(
        "--install",
        action="store_true",
        help="write it to %s instead" % COMPLETION_INSTALL_PATH,
    )
    p.set_defaults(func=cmd_completion)

    repo = sub.add_parser("repo", help="manage repos in the gg DB")
    repo_sub = repo.add_subparsers(dest="repo_command", required=True)

    p = repo_sub.add_parser("scan", help="find git repos under a path")
    p.add_argument("--max-depth", type=int)
    p.add_argument("path")
    p.set_defaults(func=cmd_repo_scan)

    p = repo_sub.add_parser("init", help="add a repo (default: current one)")
    p.add_argument("path", nargs="?")
    p.set_defaults(func=cmd_repo_init)

    p = repo_sub.add_parser("list", help="list repos")
    p.set_defaults(func=cmd_repo_list)

    p = repo_sub.add_parser("branches", help="show branches in a repo")
    p.add_argument("path", nargs="?")
    p.set_defaults(func=cmd_repo_branches)

    return parser


def main(argv=None):
    if argv is None:
        argv = sys.argv[1:]
    args = build_parser().parse_args(normalize_argv(argv))
    try:
        db = open_db(args.db)
        args.func(db, args)
    except GGError as e:
        print("gg: %s" % e, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
